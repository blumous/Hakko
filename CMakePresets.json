{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64 (CMake 4.2+)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026"
    }
  ],
  "buildPresets": [
    { "name": "debug",        "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "release",      "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "debug-2026",   "configurePreset": "vs2026-x64", "configuration": "Debug" },
    { "name": "release-2026", "configurePreset": "vs2026-x64", "configuration": "Release" }
  ]
}
